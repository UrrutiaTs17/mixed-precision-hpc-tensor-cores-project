# campana.env — parametros pre-registrados de la campana corregida
# (post-auditoria de campana_holder_20260917, job 7145). Ver DECISIONS.md
# para la justificacion de cada valor y MANIFIESTO.md para el hash de
# pre-registro. Nombres de variable identicos a los que ya aceptan
# run_gemm_chained.sbatch / run_conv_chained.sbatch / run_stencil_tc.sbatch
# (Fase_4/{GEMM,Convolution,Stencil}/) -- este archivo NO se auto-source
# todavia (los .sbatch se siguen lanzando con --export=ALL,VAR=val); es la
# fuente de verdad de la que el Paso 2 del plan arma esos --export.
#
# Uso previsto una vez integrado (Paso 2):
#   source campana.env && sbatch --export=ALL,$(...) run_gemm_chained.sbatch

set -a  # exporta todo lo que se defina abajo si este archivo se hace `source`

# ---------------------------------------------------------------------------
# Identidad de la campana (nunca pisar resultados de 7145)
# ---------------------------------------------------------------------------
CAMPANA_TAG="v2_correccion_20260927"
RESULTS_DIR_V2_BASE="results_${CAMPANA_TAG}"     # nunca "results/" a secas
ARCHIVE_DIR="${SLURM_TMPDIR:-/tmp}/campana_${CAMPANA_TAG}"  # scratch de nodo; copia unica al final

# ---------------------------------------------------------------------------
# Tolerancias y operador (DECISIONS.md S1)
# ---------------------------------------------------------------------------
GPU_FP64_TOL="1e-12"          # teorico: 2.8e-15
STENCIL_ALPHA="0.1875"        # 3/16 -- el binario espera el valor decimal, no la fraccion

# ---------------------------------------------------------------------------
# Rejilla de iteraciones (DECISIONS.md S2) -- reusa la calibracion de 7145
# ---------------------------------------------------------------------------
# GEMM
GEMM_N_LIST="1024 2048 4096 8192"
GEMM_ITERS_NUMERIC="20 40 80"
GEMM_ITERS_ENERGY_SMALL="24000"   # N=1024,2048
GEMM_ITERS_ENERGY_LARGE="500"     # N=4096,8192
GEMM_ANCHOR_LIST="0 1 5 20"

# Convolucion 2D
CONV_HW_LIST="64 128 256 512"
CONV_ITERS_NUMERIC="20 40 80"
CONV_ITERS_ENERGY_SMALL="37000"   # HW=64,128
CONV_ITERS_ENERGY_LARGE="2500"    # HW=256,512
CONV_ANCHOR_LIST="0 1 5 20"

# Stencil 2D -- operador "stress" (horizonte de desbordamiento; ya cubierto
# por 7145, se relanza solo si audit_coverage.py encuentra huecos ahi)
STENCIL_STRESS_NX_LIST="4096 8192 16384"
STENCIL_STRESS_ITERS_NUMERIC="10 50 100 120"
STENCIL_STRESS_ITERS_ENERGY_4096="4000"
STENCIL_STRESS_ITERS_ENERGY_8192="1500"
STENCIL_STRESS_ITERS_ENERGY_16384="1500"
STENCIL_STRESS_ANCHOR_LIST="0 1 8 32"

# Stencil 2D -- operador difusivo alpha=3/16 (matriz A8, prioridad de esta
# campana). Ventanas identicas a las de "stress"; la matriz completa exige
# {WMMA_FP16_SP,WMMA_BF16_SP,GPU_FP32,GPU_FP64} x {4096,8192,16384}^2 x
# K={0,1,8,32}, sin celdas vacias.
STENCIL_A316_NX_LIST="4096 8192 16384"
STENCIL_A316_ITERS_ENERGY_4096="4000"
STENCIL_A316_ITERS_ENERGY_8192="1500"
STENCIL_A316_ITERS_ENERGY_16384="1500"
STENCIL_A316_ANCHOR_LIST="0 1 8 32"
# ITERS_NUMERIC de esta matriz sale del job exploratorio de horizonte
# (Paso 5.1) -- placeholder hasta que ese job corra:
STENCIL_A316_ITERS_NUMERIC="__PENDIENTE_JOB_EXPLORATORIO__"

# Variabilidad (8 replicas, punto fijo pequeno) -- las DOS invocaciones de
# Stencil (spatial off/on) para cubrir comp_scheme={none,kahan_local,spatial}
REPLICAS="8"
REPL_GEMM_N_LIST="1024"
REPL_GEMM_ITERS_LIST="20 40"
REPL_GEMM_ANCHOR_LIST="0 1 5"
REPL_GEMM_COMP_LIST="off on"

REPL_CONV_HW_LIST="64"
REPL_CONV_ITERS_LIST="20 40"
REPL_CONV_ANCHOR_LIST="0 1 5"
REPL_CONV_COMP_LIST="off on"

REPL_STENCIL_NX_LIST="1024"
REPL_STENCIL_ITERS_LIST="20 40"
REPL_STENCIL_ANCHOR_LIST="0 1 5"
# Invocacion 1 (none + kahan_local):
REPL_STENCIL_SPATIAL_COMP_OFF="off"
REPL_STENCIL_KAHAN_LIST_OFF_INVOC="off on"
# Invocacion 2 (spatial):
REPL_STENCIL_SPATIAL_COMP_ON="on"

# ---------------------------------------------------------------------------
# Emision de datos (DECISIONS.md S4-S8) -- flags que el Paso 2 debe respetar
# una vez existan en los .cu/sbatch; se dejan documentados aqui desde ya.
# ---------------------------------------------------------------------------
RUN_NCU="0"                 # NCU nunca en pasadas de tiempo/energia
NCU_MODE_CAMPANA_APARTE="quick"
CHECKPOINT_EVERY_ENERGY="0" # o >= iters; ya forzado en GEMM, verificar Conv/Stencil

set +a
